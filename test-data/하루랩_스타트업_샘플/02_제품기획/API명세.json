{
  "mock": true,
  "version": "0.8.0",
  "service": "모아오더",
  "base_url": "https://api.moaorder.example.com/v1",
  "endpoints": [
    {
      "method": "GET",
      "path": "/stores/{store_id}/items",
      "description": "매장별 품목과 단위를 조회",
      "response_example": {
        "items": [
          {
            "id": "I001",
            "name": "우유",
            "purchase_unit": "박스",
            "units_per_pack": 12
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "발주 제출 요청 키가 같으면 기존 발주를 반환",
      "required_headers": [
        "Idempotency-Key"
      ],
      "body_example": {
        "store_id": "C003",
        "items": [
          {
            "item_id": "I001",
            "quantity": 3
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/orders/export.csv",
      "description": "최근 90일 발주 내역 내보내기"
    }
  ]
}
