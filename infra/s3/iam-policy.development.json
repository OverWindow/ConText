{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::ai-doc-workspace-dev/teams/*"
    },
    {
      "Sid": "SyncUploadCleanup",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::ai-doc-workspace-dev/teams/*/workspaces/*/sync-uploads/*"
    },
    {
      "Sid": "DistinguishMissingObject",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ai-doc-workspace-dev"
    }
  ]
}
