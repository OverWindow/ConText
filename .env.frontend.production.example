# Local production-image verification; deploy frontend/ directly to Vercel.
COMPOSE_PROJECT_NAME=docs-frontend-production
FRONTEND_IMAGE=context-frontend
IMAGE_TAG=local
FRONTEND_PORT=3000

# On Vercel set this to your frontend's public HTTPS origin.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# On Vercel set this to the Railway API HTTPS origin, without /api or a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional HTTPS installer URLs. Blank shows "배포 준비 중".
DESKTOP_MAC_DOWNLOAD_URL=
DESKTOP_WINDOWS_DOWNLOAD_URL=
