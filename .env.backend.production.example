# Local production-image verification; Railway services use platform Variables.
COMPOSE_PROJECT_NAME=docs-backend-production
BACKEND_IMAGE=context-backend
UNIFIED_IMAGE=context-unified-server
IMAGE_TAG=local
BACKEND_PORT=8000
UNIFIED_PORT=8001
# Railway provides PORT automatically. Leave the local default here.
PORT=8000

# Local Compose PostgreSQL. Use independent credentials, not development's password.
POSTGRES_USER=workspace
POSTGRES_DB=workspace
POSTGRES_PASSWORD=
# On Railway reference the PostgreSQL service's private DATABASE_URL.
DATABASE_URL=
# On Railway reference the Redis service's private REDIS_URL.
REDIS_URL=redis://redis:6379/0

# Same Supabase project used by the Vercel frontend.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# On Railway replace with the exact Vercel/custom frontend origin(s), as a JSON array.
CORS_ORIGINS=["http://localhost:3000"]
# Set this to the public frontend HTTPS origin. Empty uses the first CORS origin.
WEB_BASE_URL=
# Public Node origin, returned to desktop clients by /api/desktop/auth/config.
UNIFIED_API_URL=
# Node -> Python private origin. On Railway use http://<python-service>.railway.internal:<port>.
# Compose supplies its own backend service URL.
UNIFIED_PYTHON_URL=http://backend:8000
NODE_ENV=production
LEGACY_WORKSPACE_API_ENABLED=false
# Generate once: openssl rand -hex 32. Use the SAME private value on Node and Python.
INTERNAL_WORKER_TOKEN=
INTERNAL_WORKER_ALLOWED_HOSTS=[]
SYNC_MAX_WORKSPACE_BYTES=2147483648
SYNC_SESSION_HOURS=24

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_PRESIGNED_URL_TTL=600
MAX_UPLOAD_BYTES=52428800

PROCESSING_MAX_ATTEMPTS=3
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_MODEL=gpt-5.6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CREDENTIALS_KEY=
AI_DAILY_REQUEST_LIMIT=100
SUPABASE_PUBLISHABLE_KEY=
