# Development settings. Used by docker compose up through .env.
COMPOSE_PROJECT_NAME=docs
# Generate POSTGRES_PASSWORD with: openssl rand -hex 24
POSTGRES_USER=workspace
POSTGRES_DB=workspace
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional override. Leave blank to build the container URL from POSTGRES_*.
# Outside Docker: postgresql+psycopg://workspace:<password>@localhost:5432/workspace
DATABASE_URL=

# Public browser configuration: use the same Supabase project as SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WORKSPACE_API_URL=http://localhost:8001
UNIFIED_API_URL=http://localhost:8001
# Private Node→Python compute authentication: generate with openssl rand -hex 32.
INTERNAL_WORKER_TOKEN=
INTERNAL_WORKER_ALLOWED_HOSTS=[]

# Optional HTTPS installer URLs; blank shows "배포 준비 중" on the landing page.
DESKTOP_MAC_DOWNLOAD_URL=
DESKTOP_WINDOWS_DOWNLOAD_URL=

# Backend authentication. ES256 / RS256 use the project's public JWKS automatically.
SUPABASE_URL=
# Only required for projects still using the legacy HS256 shared signing secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=["http://localhost:3000"]
# Empty WEB_BASE_URL uses the first CORS origin for "open on web".
WEB_BASE_URL=http://localhost:3000
SYNC_MAX_WORKSPACE_BYTES=2147483648
SYNC_SESSION_HOURS=24

# Phase 2: private S3 bucket. Credentials are backend-only.
# Bucket suggestion: ai-doc-workspace-dev (must be globally unique).
# On AWS prefer an IAM role; then leave access keys/session token blank.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_PRESIGNED_URL_TTL=600
MAX_UPLOAD_BYTES=52428800

# Phase 4: Compose internal processing queue; do not expose Redis publicly.
REDIS_URL=redis://redis:6379/0
PROCESSING_MAX_ATTEMPTS=3

# Phase 6: backend/worker only. Override the embedding model if your gateway account requires it.
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_MODEL=gpt-5.6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small
# Personal ChatKHU keys and temporary replay responses: Fernet key, backend only.
AI_CREDENTIALS_KEY=
AI_DAILY_REQUEST_LIMIT=100
