{
  "name": "context-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ConText local folder workspace",
  "author": "ConText",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/engine.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "chokidar": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "ai.context.desktop",
    "productName": "ConText Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "../../frontend/public/brand/context-symbol.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../../frontend/public/brand/context-symbol.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
