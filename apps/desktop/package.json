{
  "name": "context-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ConText local folder workspace",
  "author": "ConText",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "processor:build": "node processor/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && npm run processor:check && electron-builder --dir",
    "dist:mac": "node scripts/check-processor.mjs darwin && npm run build && electron-builder --mac dmg",
    "dist:win": "node scripts/check-processor.mjs win32 && npm run build && electron-builder --win nsis",
    "processor:check": "node scripts/check-processor.mjs",
    "pretest": "npm --prefix ../.. run build:core"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "chokidar": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@context/contracts": "file:../../packages/contracts",
    "@context/domain": "file:../../packages/domain",
    "@context/sync-client": "file:../../packages/sync-client",
    "@context/workspace-client": "file:../../packages/workspace-client",
    "@context/workspace-ui": "file:../../packages/workspace-ui"
  },
  "build": {
    "appId": "ai.context.desktop",
    "productName": "ConText Desktop",
    "protocols": [{ "name": "ConText account return", "schemes": ["context-desktop"] }],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "processor/dist/context-processor",
        "to": "context-processor"
      }
    ],
    "files": [
      "dist/**",
      "core/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "../../packages/workspace-ui/assets/context-symbol.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../../packages/workspace-ui/assets/context-symbol.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
